{
  "name": "@zavx0z/template",
  "version": "2.6.2",
  "description": "HTML templates compiled to addressed @zavx0z/dom mutations",
  "author": "zavx0z",
  "license": "MIT",
  "packageManager": "bun@1.4.0",
  "keywords": [
    "metafor"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/zavx0z/template.git"
  },
  "bugs": {
    "url": "https://github.com/zavx0z/template/issues"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "type": "module",
  "private": false,
  "files": [
    "dist",
    "README.md",
    "requirements.md"
  ],
  "devDependencies": {
    "@zavx0z/dom": "file:../renderer/packages/dom",
    "@types/bun": "^1.4.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@zavx0z/dom": "^0.1.0",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "test": "bun test",
    "build:js": "bun build index.ts --outdir dist --target browser --format esm --external @zavx0z/dom",
    "build:types": "tsc --project tsconfig.build.json --pretty false",
    "build": "bun run typecheck && bun run build:js && bun run build:types",
    "prepublishOnly": "bun run build",
    "publish:npm": "bun publish --access public"
  }
}
